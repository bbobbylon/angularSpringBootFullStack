# ─────────────────────────────────────────────────────────────────────────────
# PROD environment — real customer traffic.
# Copy to `.env.prod` (gitignored), fill in real values, then:
#     ./deploy.sh --env prod
# IMPORTANT: every secret in here is sensitive. Use a secret manager wherever
# possible; this file should never be committed.
# ─────────────────────────────────────────────────────────────────────────────

SPRING_PROFILES_ACTIVE=prod

APP_PORT=8090

SPRING_DATASOURCE_URL=jdbc:mysql://prod-mysql.internal:3306/db2?useSSL=true&requireSSL=true
SPRING_DATASOURCE_USERNAME=app_prod

MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=ignored-when-using-external-db
MYSQL_DATABASE=db2

JWT_SECRET=different-secret-per-environment-please
