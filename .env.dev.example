# ─────────────────────────────────────────────────────────────────────────────
# DEV environment — shared development cluster.
# Typically: app deployed to a long-lived dev VM/cluster, DB on a managed
# service (RDS / Aiven / Azure DB for MySQL), real-ish data.
# Copy to `.env.dev` (gitignored), fill in real values, then:
#     ./deploy.sh --env dev
# ─────────────────────────────────────────────────────────────────────────────

SPRING_PROFILES_ACTIVE=prod

APP_PORT=8090

# Dev typically uses an external managed DB. Disable the local mysql sidecar by
# pointing at an external host. The `mysql` service in docker-compose.yml stays
# defined but isn't reachable from this URL, so it can be stopped via:
#     docker compose --env-file .env.dev stop mysql
SPRING_DATASOURCE_URL=jdbc:mysql://dev-mysql.internal:3306/db2?useSSL=true&requireSSL=true
SPRING_DATASOURCE_USERNAME=app_dev
# Use the secret manager or env-injection in your CI / orchestrator.
# DO NOT commit a real password.

MYSQL_HOST_PORT=3307            # only used if you keep the sidecar mysql running
MYSQL_ROOT_PASSWORD=ignored-when-using-external-db
MYSQL_DATABASE=db2

JWT_SECRET=different-secret-per-environment-please
