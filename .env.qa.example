# ─────────────────────────────────────────────────────────────────────────────
# QA environment template.
# Copy to .env.qa (gitignored), fill in real values, then run:
#   docker compose --env-file .env.qa up
# ─────────────────────────────────────────────────────────────────────────────

# ── Spring profile ────────────────────────────────────────────────────────────
SPRING_ACTIVE_PROFILES=qa
CONTAINER_PORT=8080
APP_PORT=8091             # different host port avoids clashing with a running dev instance

# ── QA database (separate schema from dev — never share with prod) ─────────
MYSQL_DATABASE=tessera_qa
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-qa-root
MYSQL_USERNAME=tessera_qa_user
MYSQL_PASSWORD=change-me-qa-password
MYSQL_HOST_PORT=3307      # avoid clashing with dev MySQL on 3306
# PREFERRED encrypts when the server supports it; point this at a managed database and use
# sslMode=REQUIRED instead, which is what the qa profile pins when no explicit URL is supplied.
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3307/tessera_qa?sslMode=PREFERRED&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=tessera_qa_user
SPRING_DATASOURCE_PASSWORD=change-me-qa-password

# ── JWT ───────────────────────────────────────────────────────────────────────
# Use a DIFFERENT secret from dev and prod. Generate: openssl rand -base64 48
JWT_SECRET=replace-with-qa-jwt-secret-at-least-32-chars

# ── Email ─────────────────────────────────────────────────────────────────────
MAIL_USERNAME=your-qa-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
VERIFY_EMAIL_HOST=http://localhost:8091

# ── Frontend ──────────────────────────────────────────────────────────────────
UI_APP_URL=http://localhost:4200

# ── Image storage ─────────────────────────────────────────────────────────────
# Use local storage in QA unless testing S3 specifically.
IMAGE_STORAGE_TYPE=local
# IMAGE_STORAGE_TYPE=s3
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=tessera-app-images-qa

# ── SQL logging (opt-in for test debugging) ───────────────────────────────────
SHOW_SQL=false
