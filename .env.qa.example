# ─────────────────────────────────────────────────────────────────────────────
# QA environment — pre-production verification of release candidates.
# Should mirror PROD config as closely as possible; only the host names and
# credentials differ. Copy to `.env.qa` (gitignored) and then:
#     ./deploy.sh --env qa
# ─────────────────────────────────────────────────────────────────────────────

SPRING_PROFILES_ACTIVE=prod

APP_PORT=8090

SPRING_DATASOURCE_URL=jdbc:mysql://qa-mysql.internal:3306/db2?useSSL=true&requireSSL=true
SPRING_DATASOURCE_USERNAME=app_qa

MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=ignored-when-using-external-db
MYSQL_DATABASE=db2

JWT_SECRET=different-secret-per-environment-please
