# ─────────────────────────────────────────────────────────────────────────────
# Environment template for the Angular + Spring Boot app.
# Copy this file to `.env` and replace every placeholder with a real value:
#
#   cp .env.example .env            (Linux / macOS / Git Bash)
#   Copy-Item .env.example .env     (PowerShell)
#
# `.env` is gitignored and must NEVER be committed. Only this sanitized template
# (placeholders only — no real secrets) is tracked, via the `!.env.example`
# whitelist in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ── MySQL ────────────────────────────────────────────────────────────────────
# Used by the Docker MySQL container (DB=local) and by the app to connect.
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=db2
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me-app-password

# ── Database transport security ──────────────────────────────────────────────
# Controls the TLS ladder on the JDBC connection. Applies only to the URL that
# application.yml assembles from MYSQL_* — an explicit SPRING_DATASOURCE_URL
# below wins and must carry its own sslMode.
#
#   DISABLED | PREFERRED | REQUIRED | VERIFY_CA | VERIFY_IDENTITY
#
# PREFERRED (the default) encrypts whenever the server supports it and falls
# back silently when it does not, so a bare local MySQL still starts. The
# deployed profiles pin REQUIRED, which refuses to connect without TLS —
# a silent downgrade to plaintext is the thing you cannot allow on a database
# reached over the public internet.
#
# REQUIRED encrypts but does NOT verify whose certificate is on the other end.
# VERIFY_IDENTITY does, and needs the provider's CA in a truststore.
#MYSQL_SSL_MODE=PREFERRED
#MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true   # only meaningful without TLS; off in prod

# Optional explicit datasource override. Spring's relaxed binding maps these onto
# spring.datasource.*, taking precedence over the URL assembled from MYSQL_* in
# application.yml — INCLUDING MYSQL_SSL_MODE above, so spell sslMode out here.
# start.sh (DB=aiven) and docker-compose.yml set these for you.
SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/db2?sslMode=PREFERRED&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me-app-password

# ── Spring ───────────────────────────────────────────────────────────────────
SPRING_ACTIVE_PROFILES=dev          # dev | qa | stage | prod
                                    # See .env.qa.example / .env.stage.example for per-env templates
                                    # Run a non-dev env: docker compose --env-file .env.qa up
CONTAINER_PORT=8080                 # port Spring Boot listens on
APP_PORT=8090                       # host port mapped to the container (docker mode)

# ── JWT ──────────────────────────────────────────────────────────────────────
# Generate one:  openssl rand -base64 48
JWT_SECRET=replace-with-random-base64-string-at-least-32-chars

# ── Email (Gmail SMTP) ───────────────────────────────────────────────────────
# MAIL_PASSWORD must be a 16-char Gmail App Password, not your account password:
#   https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
VERIFY_EMAIL_HOST=http://localhost:8080   # reserved for future use; links currently use UI_APP_URL

# ── Frontend ─────────────────────────────────────────────────────────────────
UI_APP_URL=http://localhost:4200    # used for CORS and as the base for email verification links

# ── Profile image storage ────────────────────────────────────────────────────
# Storage backend: local (default) or s3.
# Set IMAGE_STORAGE_TYPE=s3 and the AWS variables below for cloud deployments.
IMAGE_STORAGE_TYPE=local

# Directory used by the local backend. Leave unset (defaults to ~/tesseraapp/images).
# In Docker/cloud point it at a MOUNTED VOLUME so images persist across restarts.
#IMAGE_STORAGE_PATH=/app/data/images

# ── AWS (required when IMAGE_STORAGE_TYPE=s3) ────────────────────────────────
# For ECS Fargate: attach a task role with s3:PutObject + s3:GetObject on the bucket
# instead of providing static keys. The SDK will use the task role automatically.
#AWS_REGION=us-east-1
#AWS_S3_BUCKET=tessera-app-images
# Static credentials (local dev only — never use in production; use task/instance roles):
#AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
#AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ── docker-compose MySQL host port ────────────────────────────────────────────
# Host port mapped to the MySQL container's 3306. Change if 3306 is already in use.
MYSQL_HOST_PORT=3306

# ── Federated login (OAuth2 / OIDC) — OPTIONAL ──────────────────────────────
# Each provider's login button appears only when its CLIENT_ID is set (discovery
# via GET /oauth2/providers). Register the callback URL
#   http://localhost:8080/login/oauth2/code/{provider}     (provider = google|github|microsoft)
# in the provider's developer console:
#   Google:    https://console.cloud.google.com/apis/credentials
#   GitHub:    https://github.com/settings/developers  (OAuth Apps)
#   Microsoft: https://entra.microsoft.com  (App registrations)
#GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=your-google-client-secret
#GITHUB_CLIENT_ID=your-github-oauth-app-client-id
#GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
#MICROSOFT_CLIENT_ID=your-azure-app-registration-client-id
#MICROSOFT_CLIENT_SECRET=your-azure-client-secret
#MICROSOFT_TENANT_ID=common              # common | consumers | organizations | your tenant GUID

# ── Passkeys (WebAuthn) ──────────────────────────────────────────────────────
# Requires a secure context (HTTPS, or localhost) — browsers refuse WebAuthn on
# plain http:// non-localhost origins. Both values default from UI_APP_URL
# (rp-id = its host, origin = the URL itself), which is correct for this app's
# single-origin deployment; set these only if the API and SPA are ever split
# across different hosts.
#WEBAUTHN_RP_ID=your-spa-host                    # e.g. d3911jyxcju4q4.cloudfront.net
#WEBAUTHN_ORIGIN=https://your-public-origin       # scheme+host the browser actually sees

# ── Reverse proxy / load balancer ────────────────────────────────────────────
# Leave ALL THREE unset for local runs — the defaults ("no proxy") are correct
# there. Set them on any load-balanced deployment; each fails silently, not loudly.
#
# FORWARD_HEADERS_STRATEGY governs URLs the app GENERATES. At the default `none`,
# {baseUrl} in the OAuth2 redirect-uri template resolves to the container's own
# http://<task-ip>:8080, so every federated sign-in dies on redirect_uri_mismatch
# while working perfectly on localhost.
#
# TRUSTED_PROXY_COUNT governs the client IP the app READS from X-Forwarded-For.
# At the default 0 the header is ignored and every user looks like the load
# balancer: the rate limiter throttles the whole tenant as one caller, and the
# login-anomaly detector's NEW_NETWORK signal can never fire. Match the REAL hop
# count — too high and an attacker-supplied header entry becomes trusted.
#
# OAUTH2_REDIRECT_BASE_URL pins the scheme+host of the OAuth redirect URI instead
# of deriving it from the request. Needed when a proxy chain makes
# X-Forwarded-Proto untrustworthy — the live case is CloudFront in front of the
# ALB: CloudFront sets it to https, the ALB OVERWRITES it with its own listener
# protocol (http), and the app then emits redirect_uri=http://… which Google and
# Entra reject. FORWARD_HEADERS_STRATEGY=framework does not save you; it honours
# the header faithfully and the header is wrong. Leave it unset locally.
#FORWARD_HEADERS_STRATEGY=framework      # `none` (default) | framework | native
#TRUSTED_PROXY_COUNT=1                   # 1 behind a single ALB; 2 with a CDN in front
#OAUTH2_REDIRECT_BASE_URL=https://your-public-origin   # no trailing slash needed; one is trimmed

# INTERNAL_DOMAINS drives the admin user-type badge (INTERNAL/EXTERNAL/FEDERATED). Comma-separated
# email domains that count as INTERNAL; everything else (that isn't federated) reads EXTERNAL.
# Blank/unset (the default) means nothing qualifies as INTERNAL.
#INTERNAL_DOMAINS=lewisu.edu,tesseraapp.dev

# ── SMS 2FA (Twilio) — OPTIONAL ──────────────────────────────────────────────
# Leave these as placeholders and the code is logged instead of sent (dev/CI-safe,
# no Twilio account needed). Fill in real values from your Twilio console and SMS
# 2FA sends for real — every text incurs a Twilio cost once these are live.
TWILIO_FROM_NUMBER=+10000000000
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# ── Aiven cloud MySQL — only needed when start.sh DB=aiven ────────────────────
AIVEN_DB_HOST=your-instance.aivencloud.com
AIVEN_DB_PORT=00000
AIVEN_DB_NAME=db3
AIVEN_DB_USERNAME=avnadmin
AIVEN_DB_PASSWORD=change-me-aiven-password
