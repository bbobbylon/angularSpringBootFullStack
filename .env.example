# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for local Docker deployment.
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
#   cp .env.example .env       (Linux / macOS / Git Bash)
#   Copy-Item .env.example .env   (PowerShell)
# ─────────────────────────────────────────────────────────────────────────────

# MySQL container — used by both the mysql service (to initialize) and
# by the app service (to connect via SPRING_DATASOURCE_PASSWORD).
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_DATABASE=db2

# Host port to publish the app on. Defaults to 8090 to avoid clashing with a
# native `./mvnw spring-boot:run` already on 8080. Set to 8080 if 8080 is free.
APP_PORT=8090

# JWT signing key for the Spring Boot app. Use a long random string in production.
# Generate one with:   openssl rand -base64 48
# (or in PowerShell:   [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 })) )
JWT_SECRET=replace-with-a-long-random-secret-at-least-48-bytes
