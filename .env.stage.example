# ─────────────────────────────────────────────────────────────────────────────
# STAGE environment — final pre-prod gate, prod-like traffic if shadowed.
# Same shape as .env.prod but pointed at the staging cluster's resources.
# Copy to `.env.stage` (gitignored) and then:
#     ./deploy.sh --env stage
# ─────────────────────────────────────────────────────────────────────────────

SPRING_PROFILES_ACTIVE=prod

APP_PORT=8090

SPRING_DATASOURCE_URL=jdbc:mysql://stage-mysql.internal:3306/db2?useSSL=true&requireSSL=true
SPRING_DATASOURCE_USERNAME=app_stage

MYSQL_HOST_PORT=3307
MYSQL_ROOT_PASSWORD=ignored-when-using-external-db
MYSQL_DATABASE=db2

JWT_SECRET=different-secret-per-environment-please
