# ─────────────────────────────────────────────────────────────────────────────
# Staging environment template.
# Copy to .env.stage (gitignored), fill in real values, then run:
#   docker compose --env-file .env.stage up
# ─────────────────────────────────────────────────────────────────────────────

# ── Spring profile ────────────────────────────────────────────────────────────
SPRING_ACTIVE_PROFILES=stage
CONTAINER_PORT=8080
APP_PORT=8092

# ── Staging database (Aiven or other managed MySQL) ───────────────────────────
MYSQL_DATABASE=tessera_stage
MYSQL_HOST=your-stage-instance.aivencloud.com
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-stage-root
MYSQL_USERNAME=avnadmin
MYSQL_PASSWORD=change-me-stage-password
SPRING_DATASOURCE_URL=jdbc:mysql://your-stage-instance.aivencloud.com:3306/tessera_stage?useSSL=true&requireSSL=true
SPRING_DATASOURCE_USERNAME=avnadmin
SPRING_DATASOURCE_PASSWORD=change-me-stage-password

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=replace-with-stage-jwt-secret-at-least-32-chars

# ── Email ─────────────────────────────────────────────────────────────────────
MAIL_USERNAME=your-stage-gmail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
VERIFY_EMAIL_HOST=https://stage.yourdomain.com

# ── Frontend ──────────────────────────────────────────────────────────────────
UI_APP_URL=https://stage.yourdomain.com

# ── Image storage (S3 recommended in staging — mirrors prod) ─────────────────
IMAGE_STORAGE_TYPE=s3
AWS_REGION=us-east-1
AWS_S3_BUCKET=tessera-app-images-stage
# Static credentials for local staging run only. In ECS, attach a task role instead.
# AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
# AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# ── Twilio (optional — keep stubbed unless testing real SMS) ──────────────────
TWILIO_FROM_NUMBER=+10000000000
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
