meta {
  name: Create Service
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/admin/services/create
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Bruno Test Service",
    "description": "Created by the Bruno collection — safe to leave retired.",
    "price": 1.00
  }
}

script:post-response {
  const json = res.getBody();
  if (json.data && json.data.service) {
    bru.setVar("serviceId", json.data.service.id);
  }
}

tests {
  test("status is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
