meta {
  name: Register
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/user/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "firstName": "Bruno",
    "lastName": "Test",
    "email": "bruno.test.{{$timestamp}}@example.com",
    "password": "BrunoTest@123"
  }
}

tests {
  test("status is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
