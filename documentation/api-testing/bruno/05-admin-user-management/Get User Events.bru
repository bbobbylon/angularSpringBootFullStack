meta {
  name: Get User Events
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/admin/user/{{adminId}}/events?page=0&size=10
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

params:query {
  page: 0
  size: 10
}

tests {
  test("status is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
