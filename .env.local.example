# ─────────────────────────────────────────────────────────────────────────────
# LOCAL environment (default) — Docker stack on your laptop.
# Copy to `.env.local` (gitignored) and fill in real values:
#     cp .env.local.example .env.local        (Linux / macOS / Git Bash)
#     Copy-Item .env.local.example .env.local (PowerShell)
# Then deploy with:
#     ./deploy.sh --env local
# (or just `./deploy.sh` — `local` is the default if --env is omitted)
# ─────────────────────────────────────────────────────────────────────────────

SPRING_PROFILES_ACTIVE=prod

# Host port to publish the app on. 8090 by default to dodge a native
# `./mvnw spring-boot:run` that may still be on 8080.
APP_PORT=8090

# MySQL container — used by both the mysql service (to initialize) and
# by the app service (to connect via SPRING_DATASOURCE_PASSWORD).
# Host port 3307 → container port 3306 so a native MySQL on 3306 can coexist.
MYSQL_ROOT_PASSWORD=change-me-strong-password
MYSQL_DATABASE=db2
MYSQL_HOST_PORT=3307

# Datasource URL the app uses *inside* the docker network — service name `mysql`,
# container port 3306. Do NOT change to host.docker.internal here; the app talks
# to MySQL container-to-container, not via the host.
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/db2?useSSL=false&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
# Inherits MYSQL_ROOT_PASSWORD by default; deploy.sh wires it through.

# JWT signing key. Generate one with:
#   openssl rand -base64 48
#   (PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 })) )
JWT_SECRET=replace-with-a-long-random-secret-at-least-48-bytes
