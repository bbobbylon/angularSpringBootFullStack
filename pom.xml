<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>
    <groupId>com.bob</groupId>
    <artifactId>angularSpringBootFullStack</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>angularSpringBootFullStack</name>
    <description>angularSpringBootFullStack</description>
    <url/>
    <licenses>
        <license/>
    </licenses>
    <developers>
        <developer/>
    </developers>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>
    <properties>
        <java.version>21</java.version>
        <spring-framework.version>7.0.7</spring-framework.version>
        <spring-security.version>7.0.5</spring-security.version>
        <tomcat.version>11.0.22</tomcat.version>
    </properties>
    <!-- OpenSAML (a transitive dependency of spring-security-saml2-service-provider, below) is not
         published to Maven Central — Shibboleth publishes it only to its own Nexus repository. -->
    <repositories>
        <repository>
            <id>shibboleth</id>
            <name>Shibboleth Releases</name>
            <url>https://build.shibboleth.net/nexus/content/repositories/releases/</url>
        </repository>
    </repositories>
    <dependencyManagement>
        <dependencies>
            <!-- jjwt removed: only com.auth0:java-jwt is used in TokenProvider.
                 Keeping these three as version pins served no purpose. -->
            <dependency>
                <groupId>org.json</groupId>
                <artifactId>json</artifactId>
                <version>20240303</version>
            </dependency>
            <!-- AWS SDK v2 BOM — pins all AWS SDK modules to a consistent version -->
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>2.30.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
    <dependencies>
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>5.5.1</version>
        </dependency>
        <!-- OpenPDF (POST-SUBMISSION-UPGRADES.md "PDF invoice attachments"): renders the
             server-side invoice PDF in InvoicePdfReport, used both as a direct download and as
             an email attachment. LGPL/MPL dual-licensed fork of iText 4 — chosen deliberately
             over iText 5+/7, which relicensed to AGPL and is not a license this project can carry
             as a dependency. -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>1.3.30</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- OAuth2 client (SRS CON-5 / FR-FED): Spring Security's standard implementation of the
             OAuth2 Authorization Code flow for federated login via Google, GitHub, and Microsoft.
             The bespoke work is limited to the token-exchange handler (OAuth2LoginSuccessHandler);
             protocol handling, state validation, and code exchange are all framework-provided. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-client</artifactId>
        </dependency>
        <!-- SAML 2.0 service provider (FUTURE-ENHANCEMENTS.md §3.1 "Per-organization external IdP",
             Stage 3): the sibling of the OAuth2 client above for organizations whose IdP only speaks
             SAML. A genuinely separate dependency, not an extension of oauth2-client — SAML's
             RelyingPartyRegistration/RelyingPartyRegistrationRepository types share no machinery with
             OAuth2's ClientRegistration/ClientRegistrationRepository. No version pinned here — like
             every other spring-security-* artifact in this file, it is managed by the
             ${spring-security.version} property above via spring-boot-dependencies. -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-saml2-service-provider</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- removing PostgreSQL boilerplate for now since we are using MySQL -->
        <!--        <dependency>-->
        <!--            <groupId>org.postgresql</groupId>-->
        <!--            <artifactId>postgresql</artifactId>-->
        <!--            <scope>runtime</scope>-->
        <!--        </dependency>-->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.18.0</version>
        </dependency>
        <!-- Batch upload (FUTURE-ENHANCEMENTS.md §3.3 "P2-2"): CSV parsing for
             POST /customer/batch and /customer/invoice/batch. XLSX parsing reuses the
             poi-ooxml dependency already declared above for the existing report exports. -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>1.14.1</version>
        </dependency>
        <dependency>
            <groupId>com.twilio.sdk</groupId>
            <artifactId>twilio</artifactId>
            <version>10.6.2</version>
        </dependency>
        <dependency>
            <groupId>com.auth0</groupId>
            <artifactId>java-jwt</artifactId>
            <version>4.4.0</version>
        </dependency>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Boot 4.0 split TestRestTemplate out of spring-boot-test into its own module
             (SecurityFilterChainIntegrationTest: real HTTP calls through the actual
             SecurityFilterChain, POST-SUBMISSION-UPGRADES.md #9) — no longer transitive
             via spring-boot-starter-test. TestRestTemplate itself wraps a RestTemplateBuilder,
             which Boot 4.0 also split out (spring-boot-restclient) rather than bundling it —
             the app has no other RestTemplate/RestClient usage, so both are test-scoped only. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-resttestclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-restclient</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- JSON structured logging for prod/qa/stage (POST-SUBMISSION-UPGRADES.md "Structured
             logging + metrics"): renders Logback events as one JSON object per line via
             logback-spring.xml's LogstashEncoder appender, so CloudWatch Logs Insights can query
             level/logger_name/message as first-class fields instead of substring-matching plain
             text. Not managed by the Spring Boot BOM (a third-party project, not part of Spring's
             release train) — version pinned explicitly like the other non-Boot dependencies above
             (twilio, java-jwt, zxing, bucket4j, webauthn4j). 7.4 targets SLF4J 2.x / Logback
             1.3–1.5, matching the Logback 1.5.x line spring-boot-starter-parent:4.0.6 resolves. -->
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
            <version>7.4</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>nl.basjes.parse.useragent</groupId>
            <artifactId>yauaa</artifactId>
            <version>7.24.0</version>
        </dependency>
        <!-- ZXing (SRS FR-MFA-4): renders the otpauth:// provisioning URI as a QR code PNG
             during TOTP enrollment. Generated server-side and returned as a base64 data URI
             so the shared secret never leaves the application or requires a frontend QR
             dependency. The TOTP algorithm itself (RFC 6238) is implemented in-house in
             TotpUtils — only the QR rasterization is delegated to a library. -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>3.5.3</version>
        </dependency>
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.3</version>
        </dependency>
        <!-- Flyway removed: schema is now defined by src/main/resources/schema.sql (idempotent,
             non-destructive). Flyway's baseline bookkeeping repeatedly desynced from the live
             database and blocked startup, so it was dropped in favour of the simpler model. -->

        <!-- Bucket4j: in-memory token-bucket rate limiting (SRS FR-TPF-3 / NFR-SEC-RL).
             Core module only (no servlet dependency); the filter wiring is handled by
             RateLimitFilter which extends OncePerRequestFilter. For distributed rate limiting
             across multiple instances, replace the in-memory store with bucket4j-redis or
             bucket4j-hazelcast without changing the filter logic. -->
        <dependency>
            <groupId>com.bucket4j</groupId>
            <artifactId>bucket4j-core</artifactId>
            <version>8.10.1</version>
        </dependency>

        <!-- AWS SDK v2 S3 client — used by S3ImageStorageService when IMAGE_STORAGE_TYPE=s3.
             Version is managed by the AWS BOM in dependencyManagement above. The client
             is only instantiated (via AwsS3Config) when s3 mode is active, so local-dev
             builds carry the dependency on the classpath but never open an S3 connection. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>

        <!-- WebAuthn4J: passkey (WebAuthn) registration/assertion verification, used directly
             rather than Spring Security's session-based spring-security-webauthn module, which
             assumes cookie/session auth. This app is deliberately stateless JWT (CustomAuthFilter),
             so the ceremony ("options" + "verify" round trip) is wired through PasskeyService the
             same way TotpUtils hand-rolls RFC 6238 rather than pulling in a framework's own MFA
             machinery. See PasskeyServiceImpl for the WebAuthnManager usage. -->
        <dependency>
            <groupId>com.webauthn4j</groupId>
            <artifactId>webauthn4j-core</artifactId>
            <version>0.29.1.RELEASE</version>
        </dependency>
        <dependency>
            <groupId>com.webauthn4j</groupId>
            <artifactId>webauthn4j-test</artifactId>
            <version>0.29.1.RELEASE</version>
            <scope>test</scope>
        </dependency>

        <!-- Caffeine (FUTURE-ENHANCEMENTS.md §3.1 "Per-organization external IdP", Stage 2):
             short-TTL cache for OrgAwareClientRegistrationRepository's resolved ClientRegistration
             objects. ClientRegistrations.fromIssuerLocation(...) makes a live HTTP call to the IdP's
             .well-known/openid-configuration on every invocation, and this resolver runs on every
             single SSO redirect. Used directly rather than Spring's cache abstraction/@Cacheable,
             since only one method needs manual eviction-by-key when an admin edits a configuration.
             Version is managed by spring-boot-dependencies (this artifact backs Boot's own cache
             auto-configuration), so no explicit version is pinned here. -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- Testcontainers (FUTURE-ENHANCEMENTS.md §5 "contextLoads needs a live local MySQL"):
             AngularSpringBootFullStackApplicationTests boots the full Spring context against a
             throwaway containerized MySQL instead of requiring a specific always-running local/CI
             MySQL (db2, Aiven, or a CI service container). spring-boot-testcontainers supplies
             @ServiceConnection, which derives spring.datasource.* from the started container
             automatically — no manual @DynamicPropertySource wiring needed. Versions are managed by
             spring-boot-dependencies, which imports the Testcontainers BOM, so none are pinned here. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mysql</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>
    <profiles>
        <profile>
            <id>dev</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <properties>
                <spring.profiles.active>
                    dev
                </spring.profiles.active>
            </properties>
        </profile>
        <profile>
            <id>prod</id>
            <properties>
                <spring.profiles.active>
                    prod
                </spring.profiles.active>
            </properties>
        </profile>
        <profile>
            <id>qa</id>
            <properties>
                <spring.profiles.active>
                    qa
                </spring.profiles.active>
            </properties>
        </profile>
        <profile>
            <id>stage</id>
            <properties>
                <spring.profiles.active>
                    stage
                </spring.profiles.active>
            </properties>
        </profile>
        <profile>
            <id>local</id>
            <properties>
                <spring.profiles.active>
                    local
                </spring.profiles.active>
            </properties>
        </profile>
    </profiles>

    <build>
        <plugins>
            <plugin>
                <groupId>org.owasp</groupId>
                <artifactId>dependency-check-maven</artifactId>
                <version>12.1.1</version>
                <configuration>
                    <failBuildOnCVSS>7</failBuildOnCVSS>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>versions-maven-plugin</artifactId>
                <version>2.18.0</version>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>default-compile</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>compile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                    <execution>
                        <id>default-testCompile</id>
                        <phase>test-compile</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                        <configuration>
                            <annotationProcessorPaths>
                                <path>
                                    <groupId>org.projectlombok</groupId>
                                    <artifactId>lombok</artifactId>
                                </path>
                            </annotationProcessorPaths>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
