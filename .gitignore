# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example
!.env.qa.example
!.env.stage.example
!.env.e2e.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp and cache directory
.temp
.cache

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores VSCode versions used for testing VSCode extensions
.vscode-test

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite logs files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# PSQL db creation .sql file

psqlschema.sql

.claude
target/*
application-dev.yml
application.yml
application-prod.yml

# Microsoft Office temp / lock files (e.g. ~WRL3006.tmp, ~$report.docx)
~$*
~WRL*.tmp
/assignments

# ── Playwright end-to-end suite ───────────────────────────────────────────────
# Run artifacts: regenerated on every run, large, and meaningless outside the run
# that produced them (traces and videos are retained only for failures).
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Cached signed-in browser state written by e2e/auth.setup.ts. Holds a real (if
# throwaway) JWT for a seeded demo account, and is rebuilt on every run — there is
# no case where committing it is correct.
/e2e/.auth/

# The E2E environment file. Unlike .env.e2e.example (which is tracked and contains
# only working local defaults), this is a real local file and follows the same
# never-commit rule as .env — the `.env.*` pattern above already catches it, but it
# is named here so the intent is explicit rather than incidental.
.env.e2e
