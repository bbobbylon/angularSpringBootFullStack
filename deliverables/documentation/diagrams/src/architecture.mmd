---
title: SecureCapita - System Architecture
---
flowchart TB
    user(["End User / Browser"])

    subgraph client["Angular 21 Client (securecapitaapp)"]
        direction TB
        pages["Feature Pages<br/>Auth · Home · Customers · Invoices · Profile"]
        shared["Shared Components<br/>Navbar · Stats"]
        ngservices["HTTP Services<br/>(src/app/service)"]
        guard["Route Guard<br/>authenticationGuard"]
        interceptor["HTTP Interceptor<br/>(JWT bearer injection)"]
        pages --> ngservices
        shared --> ngservices
        guard -. protects .-> pages
        ngservices --> interceptor
    end

    subgraph server["Spring Boot 4 / Java 21 Server"]
        direction TB
        filter["Security Filters<br/>JWT Authorization Filter"]
        controllers["REST Controllers<br/>UserController · CustomerController"]
        services2["Service Layer<br/>User · Customer · Email · Role · Event · Notification"]
        token["JWT Token Provider<br/>access + refresh tokens"]
        report["Report Module<br/>Apache POI (XLSX export)"]
        repo["Repository Layer<br/>JPA / JDBC"]
        filter --> controllers
        controllers --> services2
        services2 --> token
        services2 --> report
        services2 --> repo
    end

    subgraph external["External / Infra"]
        direction TB
        db[("MySQL 8.4<br/>Flyway migrations")]
        mail["SMTP Mail<br/>(verification & reset emails)"]
        sms["Twilio SMS<br/>(2FA - optional)"]
    end

    user --> client
    interceptor -- "HTTPS / REST + JWT" --> filter
    repo --> db
    services2 --> mail
    services2 --> sms

    subgraph docker["Docker Compose"]
        direction LR
        dc1["app container"]
        dc2["mysql container"]
    end
    server -.runs in.-> dc1
    db -.runs in.-> dc2
