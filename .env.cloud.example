# ─────────────────────────────────────────────────────────────────────────────
# Cloud registry credentials for `./deploy.sh --aws-push` / `--azure-push`.
# Copy this file to `.env.cloud` and fill in the values for the cloud(s) you
# actually use. The file is gitignored — never commit real values.
#
#   cp .env.cloud.example .env.cloud
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS (used by ./deploy.sh --aws-push) ─────────────────────────────────────
# Get these from the CloudFormation stack outputs or your AWS Console.
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=000000000000
AWS_ECR_REPOSITORY=securecapita

# ── Azure (used by ./deploy.sh --azure-push) ─────────────────────────────────
# AZURE_ACR_NAME is the bare name without .azurecr.io (e.g. 'bobsangularapp').
AZURE_ACR_NAME=bobsangularapp
AZURE_RESOURCE_GROUP=bobsresourcegroup
# Optional: if set, deploy.sh will restart the App Service after pushing the image.
AZURE_APP_SERVICE_NAME=angularSpringBootFullStack

# ── Both clouds (optional) ───────────────────────────────────────────────────
# IMAGE_TAG=custom-tag-here   # if unset, defaults to short git SHA or timestamp
